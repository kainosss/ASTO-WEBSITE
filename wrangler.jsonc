// Cloudflare Workers configuration for the ASTO SECURITY website.
//
// The website is static files in ./public. A small Worker (worker/index.js) handles only /api/* for the
// enquiry form; every other request is served straight from ./public. No build step, no dependencies.
// Only ./public and the Worker script are uploaded, so CLAUDE.md, docs/ and .git are never served.
//
// Workers Builds runs `wrangler deploy` on the production branch and `wrangler versions upload` /
// `wrangler preview` on other branches (pull request previews); this file is required for both.
//
// Secrets (FORM_ENABLED, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, APPS_SCRIPT_URL,
// APPS_SCRIPT_SHARED_SECRET) are set in the Cloudflare dashboard, never here. Without all five
// (FORM_ENABLED=true) the form stays disabled.
// See docs/enquiry-form-setup.md.
//
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "asto-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the enquiry API runs the Worker; all other paths are plain static files.
    "run_worker_first": ["/api/*"],
    // Serve public/404.html (with a 404 status) for unknown URLs.
    "not_found_handling": "404-page"
  },
  // Never let a deploy remove variables set in the Cloudflare dashboard.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Required by `wrangler preview` (Workers Builds non-production branches).
  "previews": {}
}
