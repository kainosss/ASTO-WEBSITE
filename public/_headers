# Cloudflare Workers static-assets headers. This file is not served publicly.
# API responses from worker/index.js set their own headers.
#
# Indexing: pages on https://astosec.com have no X-Robots-Tag, so search engines may list them.
#   The workers.dev and preview hostnames (rule below) and all API responses send noindex.
# The headers below are security headers with no effect on the design or the enquiry form.
# Content-Security-Policy-Report-Only: browsers warn in the console but block nothing. Rename it to
#   Content-Security-Policy once a live enquiry test on astosec.com shows no CSP warnings in the
#   browser console (docs/launch-checklist.md).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

# Alternative hostnames (the workers.dev address and pull-request preview URLs) are never indexed, so
# search results only ever show https://astosec.com. Keep this rule after the launch.
https://:name.kainerpersonal.workers.dev/*
  X-Robots-Tag: noindex
